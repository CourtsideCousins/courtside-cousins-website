
---
import "../../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Game Coverage | Courtside Cousins</title>
    <meta name="description" content="Game recaps, analysis, and original reporting from Courtside Cousins." />
  </head>
  <body>
    <div class="topbar">INDEPENDENT WOMEN'S BASKETBALL MEDIA</div>

    <header class="site-header">
      <a href="/" class="brand">COURTSIDE <span>COUSINS</span></a>
      <nav>
        <a href="/">HOME</a>
        <a href="/#latest">COVERAGE</a>
        <a href="/#photography">PHOTOGRAPHY</a>
      </nav>
    </header>

    <main>
      <section class="page-hero">
        <div class="container">
          <p class="eyebrow">THE COURTSIDE COUSINS NEWSROOM</p>
          <h1>GAME COVERAGE.</h1>
          <p class="intro">From tip-off to the final buzzer. Original game recaps, analysis, and reporting from across women's basketball.</p>
        </div>
      </section>

      <section class="stories">
        <div class="container">
          <div class="section-heading">
            <h2>FROM THE COURT</h2>
            <span>GAME RECAPS & ANALYSIS</span>
          </div>

          <div class="story-grid">
            <article class="story-card">
              <img src="/images/game-coverage.jpg" alt="Women's basketball game coverage" />
              <div class="story-body">
                <p class="category">FEATURED COVERAGE</p>
                <h3>Every Game Has a Story.</h3>
                <p>Explore the action, defining moments, and stories that shape women's basketball.</p>
                <span class="coming-soon">ARTICLES COMING SOON</span>
              </div>
            </article>
          </div>
        </div>
      </section>
    </main>

    <footer>© 2026 Courtside Cousins. All rights reserved.</footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #f4f7fb;
    color: #07172e;
    font-family: Arial, sans-serif;
  }

  * { box-sizing: border-box; }
  a { text-decoration: none; }

  .container { width: min(1180px, 90%); margin: auto; }
  .topbar { background: #07172e; color: white; padding: 14px 5%; font-size: 12px; font-weight: 800; letter-spacing: 2px; }
  .site-header { background: white; padding: 28px 5%; display: flex; justify-content: space-between; align-items: center; gap: 20px; }
  .brand { color: #07172e; font-size: 23px; font-weight: 900; }
  .brand span { color: #216bd0; }
  nav { display: flex; gap: 24px; flex-wrap: wrap; }
  nav a { color: #07172e; font-size: 12px; font-weight: bold; }

  .page-hero { background: #07172e; color: white; padding: 85px 0; }
  .eyebrow, .category { color: #65b7ff; font-size: 13px; font-weight: 800; letter-spacing: 2px; }
  h1 { font-size: clamp(48px, 8vw, 92px); margin: 20px 0; line-height: 1; font-weight: 900; }
  .intro { font-size: 19px; line-height: 1.7; max-width: 690px; }

  .stories { padding: 75px 0 100px; }
  .section-heading { display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid #173f78; margin-bottom: 28px; gap: 20px; }
  .section-heading h2 { font-size: 32px; }
  .section-heading span { font-size: 13px; }
  .story-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .story-card { background: white; border: 1px solid #d6e1f0; border-radius: 8px; overflow: hidden; }
  .story-card img { width: 100%; height: 220px; object-fit: cover; display: block; }
  .story-body { padding: 24px; }
  .category { color: #216bd0; }
  .story-body h3 { font-size: 26px; margin: 12px 0; }
  .story-body p { line-height: 1.6; }
  .coming-soon { display: inline-block; margin-top: 16px; font-size: 12px; font-weight: 800; letter-spacing: 1px; color: #216bd0; }
  footer { background: #07172e; color: white; padding: 45px 5%; }

  @media (max-width: 800px) {
    .site-header { flex-direction: column; align-items: flex-start; }
    .story-grid { grid-template-columns: 1fr; }
    .section-heading { align-items: flex-start; flex-direction: column; }
  }
</style>
