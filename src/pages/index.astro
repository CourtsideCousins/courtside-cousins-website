
---
import '../styles/global.css';
import '../styles/home.css';


import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) =>
  !data.draft
)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const featuredArticle =
  articles.find((article) => article.data.featured) ?? articles[0];

const latestArticles = articles.slice(0, 6);

---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Courtside Cousins — independent women's basketball journalism, photography, podcasts, and community." />
  <title>Courtside Cousins | More Than The Game</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="topbar">
    <div class="container">INDEPENDENT WOMEN'S BASKETBALL MEDIA</div>
  </div>

  <header class="nav">
    <div class="container nav-inner">
      <a class="logo" href="/">COURTSIDE <span>COUSINS</span></a>
      <nav class="nav-links" aria-label="Main navigation">
        <a href="#latest">NEWS</a>
        <a href="#photography">PHOTOGRAPHY</a>
        <a href="#podcast">PODCAST</a>
        <a href="#about">ABOUT</a>
        <a href="mailto:hello@courtsidecousins.net">CONTACT</a>
      </nav>
    </div>
  </header>

  <main>

<div class="achievement-marquee" aria-label="Courtside Cousins achievement">
  <div class="marquee-track">
    <span>
      🏆 THREADS WNBA COMMUNITY CHAMPION
      ✦ RECOGNIZED AMONG THE TOP 31 WNBA ACCOUNTS ON THREADS
      ✦ COURTSIDE COUSINS
      ✦
    </span>
    <span aria-hidden="true">
      🏆 THREADS WNBA COMMUNITY CHAMPION
      ✦ RECOGNIZED AMONG THE TOP 31 WNBA ACCOUNTS ON THREADS
      ✦ COURTSIDE COUSINS
      ✦
    </span>
  </div>
</div>
    <section class="hero">
      <div class="container">
        <div class="eyebrow">WELCOME TO THE NEXT CHAPTER</div>
        <h1>MORE THAN THE GAME.</h1>
        
<div class="hero-grid">
  {featuredArticle ? (
    <a
      class="lead"
      href={`/articles/${featuredArticle.id}/`}
    >
      <div class="eyebrow">
        {featuredArticle.data.category.replaceAll('-', ' ').toUpperCase()}
      </div>
      <h2>{featuredArticle.data.title}</h2>
      <p class="story-description">
        {featuredArticle.data.description}
      </p>
      <span class="read-more">READ ARTICLE →</span>
    </a>
  ) : (
    <article class="lead">
      <div class="eyebrow">COURTSIDE COUSINS</div>
      <h2>Every Game Has a Story.</h2>
      <p class="story-description">
        Independent women's basketball coverage.
      </p>
    </article>
  )}

  <div class="side-stack">
    {articles
      .filter((article) => article.id !== featuredArticle?.id)
      .slice(0, 2)
      .map((article) => (
        <a
          class="side-story"
          href={`/articles/${article.id}/`}
        >
          <div class="eyebrow">
            {article.data.category.replaceAll('-', ' ').toUpperCase()}
          </div>
          <h3>{article.data.title}</h3>
          <p class="story-description">
            {article.data.description}
          </p>
        </a>
      ))}
  </div>
</div>

    </section>

    <section class="content" id="latest">
      <div class="container">
        <div class="section-heading">
          <h2>EXPLORE OUR COVERAGE</h2>
          <span>YOUR GAME. YOUR STORIES.</span>
        </div>
        <div class="cards">
          <a class="card" href="/coverage/games"">
            <div class="card-image" aria-hidden="true"></div>
            <div class="card-body">
              <div class="card-label">GAME COVERAGE</div>
              <h3>From Tip-Off to the Final Buzzer</h3>
              <p>Game recaps, analysis, and reporting from the world of women's basketball.</p>
            </div>
          </a>
          <a class="card" href="/coverage/players">
            <div class="card-image" aria-hidden="true"></div>
            <div class="card-body">
              <div class="card-label">PLAYER STORIES</div>
              <h3>Beyond the Box Score</h3>
              <p>Original perspectives and stories about the athletes who shape the game.</p>
            </div>
          </a>
          <a class="card" href="/coverage/community">
            <div class="card-image" aria-hidden="true"></div>
            <div class="card-body">
              <div class="card-label">COMMUNITY</div>
              <h3>The Culture of Women's Basketball</h3>
              <p>Connecting fans through the stories and moments that bring us together.</p>
            </div>
          </a>
        </div>
      </div>
    </section>

<section class="latest-stories">
  <div class="container">
    <div class="section-heading">
      <h2>LATEST STORIES</h2>
      <span>FRESH FROM THE COURTSIDE COUSINS NEWSROOM</span>
    </div>

    <div class="latest-grid">
      {latestArticles.length > 0 ? (
        latestArticles.map((article) => (
          <a
            class="latest-card"
            href={`/articles/${article.id}/`}
          >
            <img
              src={article.data.image}
              alt={article.data.title}
              loading="lazy"
            />

            <div class="latest-card-body">
              <span class="latest-category">
                {article.data.category.replaceAll("-", " ").toUpperCase()}
              </span>

              <h3>{article.data.title}</h3>

              <p>{article.data.description}</p>

              <span class="latest-read">READ ARTICLE →</span>
            </div>
          </a>
        ))
      ) : (
        <p>New stories are coming soon. Stay tuned!</p>
      )}
    </div>
  </div>
</section>

    <section class="feature-band">
      <div class="container feature-grid">
        <div class="feature-box" id="photography">
          <div class="eyebrow">THROUGH OUR LENS</div>
          <h2>Courtside Photography</h2>
          <p>Experience the game through original photography, event galleries, and unforgettable moments captured courtside.</p>
        </div>
        <div class="feature-box" id="podcast">
          <div class="eyebrow">THE CONVERSATION CONTINUES</div>
          <h2>The Courtside Cousins Podcast</h2>
          <p>Conversations, interviews, analysis, and the voices shaping women's basketball culture.</p>
        </div>
      </div>
    </section>

    <section class="content" id="about">
      <div class="container">
        <div class="section-heading">
          <h2>We're All Cousins Here.</h2>
        </div>
        <p>Courtside Cousins is an independent women's basketball media platform bringing together journalism, photography, podcasts, and community-driven storytelling.</p>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <div class="logo">COURTSIDE <span>COUSINS</span></div>
      <p>Independent coverage. Original storytelling. A community connected by the game.</p>
      <p>© {new Date().getFullYear()} Courtside Cousins. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
