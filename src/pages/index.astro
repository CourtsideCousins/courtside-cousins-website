
---
const siteName = "Courtside Cousins";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Courtside Cousins — independent women's basketball journalism, photography, podcasts, and community."
    />
    <title>Courtside Cousins | Women's Basketball Media</title>
    <style>
      :root {
        font-family: Arial, Helvetica, sans-serif;
        color: #ffffff;
        background: #09172d;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
      }

      header {
        padding: 24px 7%;
        border-bottom: 1px solid #30415b;
      }

      .brand {
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      main {
        max-width: 1100px;
        margin: auto;
        padding: 100px 7%;
      }

      .eyebrow {
        color: #85c8ff;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      h1 {
        font-size: clamp(2.8rem, 7vw, 5.5rem);
        line-height: 1.05;
        margin: 20px 0;
      }

      p {
        max-width: 650px;
        color: #d4dfef;
        font-size: 1.15rem;
        line-height: 1.7;
      }

      .tag {
        display: inline-block;
        margin-top: 25px;
        padding: 12px 20px;
        border: 1px solid #85c8ff;
        border-radius: 6px;
        color: #ffffff;
        font-weight: 700;
      }

      footer {
        padding: 25px 7%;
        color: #d4dfef;
        border-top: 1px solid #30415b;
      }
    </style>
  </head>

  <body>
    <header>
      <div class="brand">{siteName.toUpperCase()}</div>
    </header>

    <main>
      <div class="eyebrow">Independent Sports Media</div>

      <h1>More Than The Game.</h1>

      <p>
        Welcome to Courtside Cousins — your destination for
        women's basketball journalism, original photography,
        podcasts, and the community that brings it all together.
      </p>

      <div class="tag">A NEW ERA IS COMING</div>
    </main>

    <footer>
      © {new Date().getFullYear()} Courtside Cousins.
      All rights reserved.
    </footer>
  </body>
</html>
