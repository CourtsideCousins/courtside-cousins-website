
---
import "../../styles/global.css";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);

  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const categoryNames = {
  "game-coverage": "GAME COVERAGE",
  "player-stories": "PLAYER STORIES",
  community: "COMMUNITY",
};

const categoryName = categoryNames[article.data.category];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{article.data.title} | Courtside Cousins</title>
    <meta name="description" content={article.data.description} />
  </head>

  <body>
    <div class="topbar">INDEPENDENT WOMEN'S BASKETBALL MEDIA</div>

    <header class="site-header">
      <a href="/" class="brand">
        COURTSIDE <span>COUSINS</span>
      </a>
      <nav>
        <a href="/">HOME</a>
        <a href="/coverage/games">COVERAGE</a>
      </nav>
    </header>

    <main>
      <section class="article-hero">
        <div class="article-container">
          <p class="article-category">{categoryName}</p>
          <h1>{article.data.title}</h1>
          <p class="article-description">{article.data.description}</p>
          <p class="article-byline">
            By {article.data.author} · {article.data.publishDate.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric"
            })}
          </p>
        </div>
      </section>

      <article class="article-container article-content">
        <img
          class="article-cover"
          src={article.data.image}
          alt={article.data.title}
        />
        <Content />
      </article>

      <div class="article-container back-link">
        <a href="/coverage/games">← BACK TO COVERAGE</a>
      </div>
    </main>

    <footer>© 2026 Courtside Cousins. All rights reserved.</footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #f4f7fb;
    color: #07172e;
    font-family: Arial, sans-serif;
  }

  .topbar {
    background: #07172e;
    color: white;
    padding: 14px 5%;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .site-header {
    background: white;
    padding: 28px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .brand {
    color: #07172e;
    font-size: 23px;
    font-weight: 900;
    text-decoration: none;
  }

  .brand span {
    color: #216bd0;
  }

  nav {
    display: flex;
    gap: 24px;
  }

  nav a {
    color: #07172e;
    font-size: 12px;
    font-weight: bold;
    text-decoration: none;
  }

  .article-hero {
    background: #07172e;
    color: white;
    padding: 85px 0;
  }

  .article-container {
    width: min(850px, 90%);
    margin: 0 auto;
  }

  .article-category {
    color: #65b7ff;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(42px, 7vw, 76px);
    line-height: 1.05;
    margin: 20px 0;
  }

  .article-description {
    font-size: 20px;
    line-height: 1.6;
  }

  .article-byline {
    margin-top: 28px;
    font-size: 14px;
    color: #d2e2f7;
  }

  .article-content {
    padding: 55px 0;
    font-size: 18px;
    line-height: 1.9;
  }

  .article-cover {
    width: 100%;
    max-height: 500px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 35px;
  }

  .back-link {
    padding-bottom: 65px;
  }

  .back-link a {
    color: #216bd0;
    font-weight: 800;
    text-decoration: none;
  }

  footer {
    background: #07172e;
    color: white;
    padding: 45px 5%;
  }

  @media (max-width: 800px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .article-hero {
      padding: 55px 0;
    }
  }
</style>
